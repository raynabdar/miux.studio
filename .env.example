# ── Existing: Resend (contact / onboarding notifications) ─────────────────────
# Resend API key
RESEND_API_KEY=re_your_api_key_here
# Agency inbox that receives enquiries and onboarding notifications
CONTACT_TO_EMAIL=hello@miux.studio
# Verified Resend sender
CONTACT_FROM_EMAIL=notifications@miux.studio

# ── Clerk (authentication) ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# Webhook signing secret (Clerk Dashboard → Webhooks → endpoint)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk user id of the founder/owner. The ONLY source of founder authority.
FOUNDER_USER_ID=user_your_founder_id

# ── Database (Supabase PostgreSQL via Prisma) ─────────────────────────────────
# Runtime: pooled connection (Supavisor transaction mode, port 6543, ?pgbouncer=true)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Migrations: direct connection (port 5432)
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ── Upstash Redis (rate limiting + sign-in lockout) ───────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Cloudflare Turnstile (onboarding + auth forms) ────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Comma-separated approved frontend hostnames (never include localhost in production)
TURNSTILE_HOSTNAMES=www.miux.studio,miux.studio

# ── Meetings ──────────────────────────────────────────────────────────────────
MEETING_URL=/meeting
# Optional: Cal.com webhook signing secret (booking confirmation)
CALCOM_WEBHOOK_SECRET=

# ── Application / operations ──────────────────────────────────────────────────
APP_BASE_URL=https://www.miux.studio
# Shared secret for the demo-reset cron endpoint (Vercel sends it as Bearer token)
CRON_SECRET=
# Optional salt for hashing IP addresses in audit records
IP_HASH_SALT=

# ── Demo accounts (set only in your local/deployment environment) ─────────────
# Never commit real credentials. The seed script reads these at runtime.
DEMO_TEAM_EMAIL=
DEMO_TEAM_PASSWORD=
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=

# ── Supabase Realtime (portal chat + notifications) ──────────────────────────
# Enable Clerk as a third-party auth provider in Supabase, and create a Clerk
# JWT template named "supabase" so Realtime RLS can read auth.jwt()->>'sub'.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public client key. New projects: publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy fallback: set this instead if the project still uses an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Google Gemini (server-only AI assistant) ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
# Optional override; defaults to gemini-2.0-flash
GEMINI_MODEL=

# ── CMS media uploads (Supabase Storage) ─────────────────────────────────────
# Service-role key, server-only. Used by /admin/content to upload logos, blog
# images and featured images. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket for CMS media (defaults to cms-media)
SUPABASE_STORAGE_BUCKET=cms-media
