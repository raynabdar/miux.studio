# Resend API Key for sending contact enquiries and onboarding notifications
RESEND_API_KEY=re_your_api_key_here

# Destination email where new client enquiries and onboarding forms are delivered (agency inbox)
CONTACT_TO_EMAIL=hello@miux.studio

# Verified sender email configured in your Resend domain (e.g. hello@miux.studio or system@miux.studio)
CONTACT_FROM_EMAIL=notifications@miux.studio
